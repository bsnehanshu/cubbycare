{
  "name": "cubbycare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SF childcare finder — the app IS an MCP server",
  "scripts": {
    "seed": "tsx server/seed.ts",
    "api": "tsx server/api.ts",
    "web": "npm run dev --workspace web",
    "dev": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "mcp": "tsx server/mcp.ts"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.1",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
